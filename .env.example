ADTP_API_TOKEN="your-api-token-here"
ADTP_API_PORT=40003
# Bind address. Use 0.0.0.0 so the phone (QR mobile pairing) can reach the
# desktop REST gateway over the LAN; 127.0.0.1 keeps it loopback-only.
ADTP_API_HOST="127.0.0.1"
ADTP_AUDIT_DB="/home/youruser/.config/adtp/client-audit.db"
ADTP_CLIENT_SOCKET="/tmp/adtp-client.sock"
ADTP_SERVER_SOCKET="/tmp/adtp-server.sock"
# Socket where the desktop app exposes its embedded agent. adtp-api prefers this
# for /api/v1/agent/* (mobile chat); falls back to ADTP_CLIENT_SOCKET.
ADTP_AGENT_SOCKET="/tmp/adtp-agent.sock"
# Built-in shared assistant ("Base AI"). Users can chat with no API key out of
# the box; adding their own agent/provider keys retires it permanently. The URL
# and key below are public (the real provider key lives server-side). Override
# to self-host the same edge function.
# ADTP_BASE_AI_URL="https://yiaknrtvtgtmbgzhdlru.supabase.co/functions/v1/qwen-chat"
# ADTP_BASE_AI_SUPABASE_URL="https://yiaknrtvtgtmbgzhdlru.supabase.co"
# ADTP_BASE_AI_KEY="sb_publishable_..."
# Platform persona sent through the shared function's `context` field, so the
# desktop assistant introduces itself as ADTP (mobile keeps the MARS identity).
# Set to an empty value to send no persona.
# ADTP_BASE_AI_PERSONA="Platform: this request comes from the ADTP desktop app..."
ADTP_CORS_ORIGINS="http://localhost:*"
ADTP_RATE_LIMIT="100/minute"
ADTP_API_DOCS=true
ADTP_LOG_LEVEL="INFO"
ADTP_MAX_FILE_SIZE=10737418240
