{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ADTP Desktop",
  "version": "0.1.0",
  "identifier": "world.ashir.adtp-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "ADTP Desktop — Ashir Tech",
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "maximized": true,
        "visible": false,
        "resizable": true
      }
    ],
    "trayIcon": {
      "id": "adtp-main",
      "iconPath": "icons/tray-idle.png",
      "iconAsTemplate": false,
      "tooltip": "ADTP Desktop"
    },
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "relay_listener.py"
    ],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  }
}
